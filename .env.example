# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (Neon: usar la connection string pooled, con sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evolve
DATABASE_POOL_MAX=5

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-bytes
JWT_ISSUER=evolve-api
JWT_AUDIENCE=evolve-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Media (opcional: si se usa un CDN externo)
MEDIA_BASE_URL=

# Solo para test/db.test.ts
TEST_DATABASE_URL=
