{
  "name": "evolve-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend de Evolve: catálogo de ejercicios, planes y progreso.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/catalog.test.ts test/auth.test.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/db.test.ts test/api.test.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
